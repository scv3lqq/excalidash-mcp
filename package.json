{
  "name": "excalidash-mcp",
  "version": "0.4.0-library.1",
  "description": "MCP server for controlling self-hosted ExcaliDash drawings",
  "author": "Chaehyeon Lee",
  "license": "AGPL-3.0-only",
  "keywords": [
    "mcp",
    "excalidash",
    "excalidraw"
  ],
  "private": true,
  "type": "module",
  "bin": {
    "excalidash-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "LICENSE",
    "LICENSE-MIT",
    "PROVENANCE.md",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@resvg/resvg-js": "2.6.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17"
  },
  "engines": {
    "node": ">=20"
  }
}
